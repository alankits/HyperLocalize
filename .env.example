# Copy to .env and fill in. .env is git-ignored; never commit real values.

# dev | test | demo. Mock providers are registered only in dev and test (ADR 0005).
HYPERLOCALIZE_MODE=dev
HL_DEBUG=1
# Required in demo mode. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
HL_SECRET_KEY=
HL_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Defaults match scripts/dev_postgres.sh (local socket, port 5433).
# In Docker Compose these are set by docker-compose.yml.
HL_DB_NAME=hyperlocalize
HL_DB_USER=hl
HL_DB_PASSWORD=
HL_DB_HOST=~/.local/hl-dev/run
HL_DB_PORT=5433

# Media lives outside the repository and outside any cloud-synced folder (ADR 0004).
HL_MEDIA_ROOT=~/hl-media

# Optional: paths to ffmpeg / ffprobe. Empty = look on PATH, then the static-ffmpeg package.
HL_FFMPEG=
HL_FFPROBE=

# Optional real provider (candidate; the spike decides). Leave empty to keep it disabled.
# Free tier only, on a project with no Cloud Billing (ADR 0005). Text only, never audio.
HL_GEMINI_API_KEY=
HL_GEMINI_MODEL=gemini-3.5-flash
